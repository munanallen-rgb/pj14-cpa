SUB2API_BIND_HOST=0.0.0.0
SUB2API_PORT=18080
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
POSTGRES_DB=sub2api
JWT_SECRET=replace-with-a-32-byte-random-secret
TOTP_ENCRYPTION_KEY=replace-with-a-32-byte-random-secret
TZ=Asia/Shanghai

# CPA quota collector.
CPA_QUOTA_COLLECTOR_MANAGEMENT_KEY=replace-with-cpa-management-key
CPA_QUOTA_COLLECTOR_INSTANCES=cpa1=http://cpa1:8317,cpa2=http://cpa2:8317,cpa3=http://cpa3:8317
# Optional per-instance overrides when CPA instances use different management keys.
CPA_QUOTA_COLLECTOR_MANAGEMENT_KEY_CPA1=
CPA_QUOTA_COLLECTOR_MANAGEMENT_KEY_CPA2=
CPA_QUOTA_COLLECTOR_MANAGEMENT_KEY_CPA3=

# User-facing Portal API.
PORTAL_BIND_HOST=0.0.0.0
PORTAL_PORT=18100
PORTAL_PUBLIC_SUB2API_BASE_URL=http://<server-ip>:18080
PORTAL_SESSION_SECRET=replace-with-a-long-random-portal-session-secret
PORTAL_SESSION_TTL_HOURS=24
PORTAL_COOKIE_SECURE=false
# Comma-separated Cloudflare Pages or console origins when the frontend is hosted separately.
PORTAL_ALLOWED_ORIGINS=
PORTAL_BOOTSTRAP_ADMIN_EMAIL=portal-admin@sub2api.local
PORTAL_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-portal-admin-password
PORTAL_SUB2API_ADMIN_EMAIL=portal-service@sub2api.local
PORTAL_SUB2API_ADMIN_PASSWORD=replace-with-a-long-random-portal-sub2api-service-password
PORTAL_SUB2API_DEFAULT_GROUP_NAME=cpa-openai
PORTAL_SUB2API_DEFAULT_KEY_QUOTA=0

# Keep these permissive while Sub2API calls CPA services over Docker's private network.
SECURITY_URL_ALLOWLIST_ENABLED=false
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=true
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=true
